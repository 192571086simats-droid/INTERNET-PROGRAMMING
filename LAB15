<!DOCTYPE html>
<html>
<head>
<title>StyleHub Fashion Store</title>
<style>
body{font-family:Arial;margin:0;background:#fff5f7;color:#333}
header{background:#8e2455;color:white;text-align:center;padding:20px}
nav{background:#4d1734;text-align:center;padding:12px}
button{padding:9px;margin:4px;border:0;border-radius:5px;
