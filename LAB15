.products{display:flex;flex-wrap:wrap;gap:15px}
.card{background:#fff5f7;padding:15px;width:190px;
border:1px solid #f0c4d5;border-radius:10px;text-align:center}
.price{color:#a83265;font-weight:bold}
h2{color:#8e2455}
footer{background:#4d1734;color:white;text-align:center;padding:15px}
img{width:100%;height:130px;object-fit:cover;border-radius:8px}
</style>
</head>
<body>

<header>
<h1>👗 StyleHub</h1>
<p>Discover Your Style | Fashion for Everyone</p>
</header>

<nav>
<button onclick="show('home')">Home</button>
<button onclick="show('login')">Login / Register</button>
<button onclick="show('cart')">Cart 🛒 (<span id="count">0</span>)</button>
<button onclick="show('orders')">My Orders</button>
<button onclick="show('admin')">Admin</button>
<button onclick="show('exit')">Logout / Exit</button>
</nav>

<section id="home">
<h2>Shop by Category</h2>
<div id="categories"></div>

<h2>Fashion Subcategories</h2>
<p>Men: Shirts, T-Shirts, Trousers | Women: Dresses, Tops, Sarees |
Kids: Casual Wear, Party Wear | Footwear | Accessories</p>

<h2>Find Your Fashion</h2>
<input id="search" placeholder="Search products..."
oninput="displayProducts()">
<select id="category" onchange="displayProducts()">
<option>All</option>
<option>Men</option>
<option>Women</option>
<option>Kids</option>
<option>Footwear</option>
<option>Accessories</option>
</select>

<div id="products" class="products"></div>
</section>

<section id="login" hidden>
<h2>Customer Login / Registration</h2>
<input id="username" placeholder="Enter your name">
<input id="email" type="email" placeholder="Enter email">
<button onclick="login()">Login / Register</button>
<p id="message"></p>
</section>

<section id="cart" hidden>
<h2>Shopping Cart</h2>
<div id="cartitems"></div>
<h3 id="total">Total: ₹0</h3>
<button onclick="checkout()">Checkout</button>
</section>

<section id="orders" hidden>
<h2>Order History and Status</h2>
<div id="orderlist"></div>
</section>

<section id="admin" hidden>
<h2>Admin Product Management</h2>
<input id="pname" placeholder="Product name">
<select id="pcategory">
<option>Men</option>
<option>Women</option>
<option>Kids</option>
<option>Footwear</option>
<option>Accessories</option>
</select>
<input id="pprice" type="number" placeholder="Price">
<input id="pdesc" placeholder="Product description">
<button onclick="addProduct()">Add Product</button>
<h3>Available Products</h3>
<div id="adminlist"></div>
</section>

<section id="exit" hidden>
<h2>Thank You for Visiting StyleHub!</h2>
<p>Stay fashionable. Visit us again!</p>
<button onclick="show('home')">Return to Home</button>
</section>

<footer>
<p>© 2026 StyleHub Fashion Store</p>
</footer>

